# .env로 복사해서 값을 채운다. .env는 커밋하지 않는다.
# docker compose와 api(bootRun) 양쪽이 같은 값을 쓴다.

DB_NAME=umatgong
DB_USERNAME=umatgong
DB_PASSWORD=
DB_URL=jdbc:postgresql://localhost:5432/umatgong

# 32바이트 이상. 예: openssl rand -base64 48
JWT_SECRET=

CORS_ALLOWED_ORIGINS=http://localhost:8081

# 카카오 REST API 키. 서버 전용. 프론트로 절대 내려보내지 않는다.
KAKAO_REST_API_KEY=
