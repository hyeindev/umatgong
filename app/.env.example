# app/.env 로 복사해서 쓴다. .env는 커밋하지 않는다.
# EXPO_PUBLIC_ 값은 빌드 결과물(브라우저·앱)에 그대로 들어간다. 비밀값을 넣지 않는다.

# 백엔드 주소 (api/)
EXPO_PUBLIC_API_URL=http://localhost:8080

# 카카오 JavaScript 키 — 웹 JS SDK 전용 (카카오 로그인, 지도 렌더링).
# 브라우저에 노출되므로 카카오 콘솔에서 도메인 제한을 반드시 건다.
# REST API 키를 여기에 넣지 않는다 (백엔드 전용).
EXPO_PUBLIC_KAKAO_JS_KEY=
